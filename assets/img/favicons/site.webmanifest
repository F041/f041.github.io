---
# Con il front matter questo file sostituisce quello di Chirpy invece di entrare in conflitto con esso.
---
{
  "name": "{{ site.title }}",
  "short_name": "Economia programmata",
  "description": "{{ site.description | strip_newlines | strip }}",
  "start_url": "{{ '/' | relative_url }}",
  "display": "standalone",
  "background_color": "#f1f1ee",
  "theme_color": "#f1f1ee",
  "icons": [
    {
      "src": "{{ '/assets/img/favicons/web-app-manifest-192x192.png' | relative_url }}",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "{{ '/assets/img/favicons/web-app-manifest-512x512.png' | relative_url }}",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
